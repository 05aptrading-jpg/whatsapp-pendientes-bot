# ===================== Supabase (bot) =====================
SUPABASE_URL=https://<PROYECTO>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sbp_...
# ===================== Supabase (dashboard, GitHub Pages) =====================
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.<token anon del proyecto>
# ===================== Grupo Tablero (obtenido con el comando !id en cualquier grupo) =====================
BOARD_GROUP_JID=123456789012345@g.us
# Grupos a monitorear (separados por coma, obtén cada JID con !id). VACÍO = todos los grupos.
MONITORED_GROUPS=
# ===================== IA de clasificación (Groq o Gemini; clave gratuita) =====================
AI_PROVIDER=groq
AI_API_KEY=gsk_...
# AI_API_KEY_2, AI_API_KEY_3... : claves extra usadas si una falla (fallback ordenado)
AI_MODEL=openai/gpt-oss-20b
# ===================== Logs =====================
LOG_LEVEL=info
